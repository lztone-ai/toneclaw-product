{
  "name": "@toneclaw/product-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Host-side product plugin: assembles product storage, watches the import folder, and publishes UI snapshots.",
  "license": "UNLICENSED",
  "toneclaw": {
    "layer": "product",
    "kind": "dsh-plugin",
    "allowedExternalDependencies": []
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@toneclaw/core-domain": "workspace:*",
    "@toneclaw/product-storage": "workspace:*",
    "@toneclaw/sourcing-provider": "workspace:*"
  },
  "devDependencies": {
    "@toneclaw/billing-local": "workspace:*",
    "@toneclaw/selection-tool": "workspace:*",
    "@types/node": "22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
