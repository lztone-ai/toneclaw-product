{
  "name": "@toneclaw/sourcing-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sourcing catalog import pipeline: CSV parsing, field validation, and domain normalization.",
  "license": "UNLICENSED",
  "toneclaw": {
    "layer": "product",
    "kind": "product-library",
    "allowedExternalDependencies": []
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/",
    "fixtures/"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@toneclaw/core-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
