{
  "name": "toneclaw-product",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean:release": "node scripts/clean-release.mjs",
    "package:transport": "pnpm run build && node scripts/clean-release.mjs && pnpm --filter @toneclaw/feishu-long-connection deploy --prod release/feishu-long-connection && node scripts/generate-profile.mjs",
    "compose:desktop": "pnpm run package:transport && node packages/desktop-composition/src/compose.mjs",
    "build": "pnpm --filter @toneclaw/feishu-long-connection --filter @toneclaw/desktop-ui run build",
    "test": "pnpm --filter @toneclaw/feishu-long-connection run test",
    "typecheck": "pnpm --filter @toneclaw/feishu-long-connection run typecheck",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:ui-copy": "node scripts/check-ui-copy.mjs",
    "check:engine-lock": "node scripts/check-engine-lock.mjs",
    "check": "pnpm run check:boundaries && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:ui-copy"
  }
}
